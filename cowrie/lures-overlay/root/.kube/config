apiVersion: v1
kind: Config
clusters:
- name: stg
  cluster:
    server: https://k8s-stg.corp.internal:6443
    certificate-authority-data: @LURE_K8S_CA@
users:
- name: stg-admin
  user:
    token: @LURE_K8S_TOKEN@
contexts:
- name: stg
  context:
    cluster: stg
    user: stg-admin
    namespace: staging
current-context: stg
