# Copy to .env, fill in, and lock it down:  cp .env.example .env && chmod 600 .env
# Never commit .env. Never paste real values into chats, issues or screenshots.

# Threat-intel API keys (free tiers)
ABUSEIPDB_API_KEY=
VIRUSTOTAL_API_KEY=

# MaxMind GeoLite2 (free account; the license key is the secret, the account ID is not)
MAXMIND_ACCOUNT_ID=
MAXMIND_LICENSE_KEY=
GEOIP_DB_DIR=data/geoip
TOR_EXIT_LIST_PATH=data/tor_exit_nodes.txt

# Paths and storage
COWRIE_LOG_PATH=~/cowrie/var/log/cowrie/cowrie.json
DATABASE_URL=sqlite:///data/surya_kundal.db

# Docker Compose only. Leave COWRIE_LOG_DIR unset to read the honeypot container's own log
# (docker compose --profile honeypot up). Set it to the HOST directory containing
# cowrie.json to analyse a Cowrie that runs elsewhere.
#COWRIE_LOG_DIR=/home/you/cowrie/var/log/cowrie
# Honeypot container: logins accepted (collect or stealth) and the address port 2222 binds to.
# 127.0.0.1 keeps it local; 0.0.0.0 exposes it to the network.
#COWRIE_POLICY=collect
#COWRIE_BIND=127.0.0.1

# Dashboard (surya-kundal dashboard). The token is required to listen on anything but
# localhost; the browser asks for a password, and the token is that password.
DASHBOARD_TOKEN=
# Your own traffic (tests, the deception harness, your LAN) is tagged "internal" and left out of
# the dashboard, campaigns and exports. Loopback, private and Docker-bridge addresses count
# automatically; list any other address you test from (your own public IP), comma separated.
INTERNAL_NETWORKS=
# Set to 1 to show internal sessions on the dashboard too (for testing).
DASHBOARD_SHOW_INTERNAL=
# Wazuh alerts shown on the dashboard (optional; see wazuh/export-alerts.sh)
WAZUH_ALERTS_PATH=data/wazuh_alerts.jsonl

LOG_LEVEL=INFO
# Subnet of the honeypot's own Docker bridge; change it only if it clashes with a network you use.
#HONEY_SUBNET=172.29.77.0/24
# What the honeypot may do on the network: deny (nothing leaves, the default) or captures (web
# only, to collect malware samples). Set it together with `cowrie/egress.sh apply <mode>`;
# see docs/EGRESS.md.
#EGRESS_MODE=deny
